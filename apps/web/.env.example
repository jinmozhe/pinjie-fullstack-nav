# =============================================
# Web 前端环境变量（Next.js）
# 复制为 .env.local 并填入真实值
# NEXT_PUBLIC_ 前缀的变量会暴露给浏览器端
# =============================================

# Next.js 服务端和同域 Route Handler 使用的后端内部地址，不暴露给浏览器。
# 生产 Compose 使用 http://backend:8000，本机开发使用下面的 localhost 地址。
BACKEND_INTERNAL_URL=http://localhost:8000

# 服务端 Metadata 和认证刷新使用的公开 Web Origin，必须与 Backend 的 WEB_ORIGINS 一致。
WEB_PUBLIC_ORIGIN=http://localhost:3000

# 导航管理员登录跳转目标，与 Backend ADMIN_ORIGINS 一致。
ADMIN_PUBLIC_ORIGIN=http://localhost:3001
